rules_version = '2';

// Regras de segurança — Vallê Doces
//
// - Catálogo de produtos e dados públicos da loja: qualquer pessoa pode ler
//   (é o que abastece a loja virtual pública).
// - Todo o resto do sistema de gestão (pedidos, clientes, financeiro,
//   estoque, produção, fichas técnicas, config avançada): só usuários
//   autenticados cujo e-mail está na lista `usuariosAutorizados`, guardada
//   em configuracoes/geral.
// - Cada usuário só lê/edita o próprio perfil (usuarios/{uid}); admins
//   também podem ler todos os perfis.
// - Clientes da loja virtual (não admins) têm um cadastro em
//   clientes/{uid} (mesmo id do login) e podem criar pedidos próprios,
//   que entram no mesmo fluxo do painel de gestão.
//
// Publique com: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/configuracoes/geral)
        && ('usuariosAutorizados' in get(/databases/$(database)/documents/configuracoes/geral).data)
        && request.auth.token.email in get(/databases/$(database)/documents/configuracoes/geral).data.usuariosAutorizados;
    }

    match /produtos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /capas/{id} {
      // fotos de capa da loja virtual (base64), exibidas no carrossel público
      allow read: if true;
      allow write: if isAdmin();
    }

    match /instaCards/{id} {
      // cards da seção "Siga nosso Instagram" (imagem, título, texto, link)
      allow read: if true;
      allow write: if isAdmin();
    }

    match /configuracoes/geral {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /configuracoes/contadores {
      // usado para gerar o número sequencial do pedido (admin e loja virtual)
      allow read, write: if signedIn();
    }

    match /configuracoes/{doc} {
      allow read, write: if isAdmin();
    }

    match /usuarios/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    match /clientes/{id} {
      allow read, write: if isAdmin();
      // cliente da loja virtual cadastra/edita o próprio registro (doc id = uid)
      allow read, write: if signedIn() && request.auth.uid == id;
    }

    match /pedidos/{id} {
      allow read, update, delete: if isAdmin();
      // qualquer pessoa logada pode criar seu próprio pedido pela loja virtual
      allow create: if signedIn();
      allow read: if signedIn() && resource.data.clienteId == request.auth.uid;
    }

    match /financeiro/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if signedIn();
    }

    match /producao/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if signedIn();
    }

    match /estoque/{id} { allow read, write: if isAdmin(); }
    match /receitas/{id} { allow read, write: if isAdmin(); }

    match /newsletter/{id} {
      allow create: if request.resource.data.email is string;
      allow read, update, delete: if isAdmin();
    }
  }
}
