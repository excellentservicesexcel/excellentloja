rules_version = '2';

// Regras de segurança — Excellent Loja (multi-loja)
//
// - Cada loja vive em lojas/{lojaId}, com as configurações da loja (nome,
//   telefone, categorias, usuários autorizados, etc.) no próprio documento
//   e todo o resto do negócio (produtos, pedidos, clientes, estoque,
//   financeiro, produção, fichas técnicas, capas, cards do Instagram,
//   newsletter) em subcoleções — lojas/{lojaId}/produtos, etc.
// - Só quem está em usuariosAutorizados daquela loja (ou o super admin,
//   dono da plataforma) pode gerenciar os dados dela. Uma loja nunca
//   consegue ler/escrever dados de outra.
// - Só o super admin pode criar ou excluir lojas; quem já é autorizado
//   numa loja pode editar as configurações dela (inclusive adicionar
//   outro e-mail autorizado para a própria loja).
// - Catálogo de produtos e dados públicos da loja: qualquer pessoa pode ler
//   (é o que abastece a loja virtual pública e a página de login/landing).
// - Cada usuário só lê/edita o próprio perfil (usuarios/{uid}).
// - Clientes da loja virtual (não admins) têm um cadastro em
//   lojas/{lojaId}/clientes/{uid} (mesmo id do login) e podem criar pedidos
//   próprios, que entram no mesmo fluxo do painel de gestão daquela loja.
//
// Publique com: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn() && request.auth.token.email == 'excellentservices.excel@gmail.com';
    }

    function lojaAuthorized(lojaId) {
      return signedIn()
        && exists(/databases/$(database)/documents/lojas/$(lojaId))
        && ('usuariosAutorizados' in get(/databases/$(database)/documents/lojas/$(lojaId)).data)
        && request.auth.token.email in get(/databases/$(database)/documents/lojas/$(lojaId)).data.usuariosAutorizados;
    }

    function isLojaAdmin(lojaId) {
      return lojaAuthorized(lojaId) || isSuperAdmin();
    }

    match /lojas/{lojaId} {
      allow read: if true;
      allow create: if isSuperAdmin();
      allow update: if isLojaAdmin(lojaId);
      allow delete: if isSuperAdmin();

      match /produtos/{id} {
        allow read: if true;
        allow write: if isLojaAdmin(lojaId);
      }

      match /capas/{id} {
        allow read: if true;
        allow write: if isLojaAdmin(lojaId);
      }

      match /instaCards/{id} {
        allow read: if true;
        allow write: if isLojaAdmin(lojaId);
      }

      match /clientes/{id} {
        allow read, write: if isLojaAdmin(lojaId);
        // cliente da loja virtual cadastra/edita o próprio registro (doc id = uid)
        allow read, write: if signedIn() && request.auth.uid == id;
      }

      match /pedidos/{id} {
        allow read, update, delete: if isLojaAdmin(lojaId);
        // qualquer pessoa logada pode criar seu próprio pedido pela loja virtual
        allow create: if signedIn();
        allow read: if signedIn() && resource.data.clienteId == request.auth.uid;
      }

      match /financeiro/{id} {
        allow read, update, delete: if isLojaAdmin(lojaId);
        allow create: if signedIn();
      }

      match /producao/{id} {
        allow read, update, delete: if isLojaAdmin(lojaId);
        allow create: if signedIn();
      }

      match /estoque/{id} { allow read, write: if isLojaAdmin(lojaId); }
      match /receitas/{id} { allow read, write: if isLojaAdmin(lojaId); }

      match /meta/{id} {
        // contador sequencial de número de pedido daquela loja
        allow read, write: if signedIn();
      }

      match /newsletter/{id} {
        allow create: if request.resource.data.email is string;
        allow read, update, delete: if isLojaAdmin(lojaId);
      }
    }

    match /usuarios/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isSuperAdmin();
    }
  }
}
